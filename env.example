# Telegram API credentials — get them from https://my.telegram.org/apps
TG_API_ID=12345678
TG_API_HASH=abcdef1234567890abcdef1234567890
TG_PHONE=+359000000000

# Targets to track — comma-separated phone, @username or numeric ID
# Up to ~10 targets work comfortably with the default polling interval.
TG_TARGETS=+35980000000,@someusername,123456789

# Database file
TG_DB=status_events.db

# Fallback poll interval in seconds (minimum 60, recommended 300)
TG_POLL_INTERVAL=300

# Timezone for timestamps
TG_TZ=Europe/Sofia
