# Telegram API credentials
# Get them from https://my.telegram.org/apps
TG_API_ID=12345678
TG_API_HASH=abcdef1234567890abcdef1234567890

# Your phone number with country code
TG_PHONE=+359000000000

# Target to track: phone number (+359...), username (@username), or numeric user_id
TG_TARGET=+359895779209

# Database file name
TG_DB=status_events.db

# Fallback polling interval in seconds (default: 300 = 5 minutes)
TG_POLL_INTERVAL=300

# Timezone (default: Europe/Sofia)
TG_TZ=Europe/Sofia
